# ====================================================================
# HireSync Environment Variables Template
# Copy this file to '.env' for local development and update values.
# NEVER commit real credentials, API keys, or production secrets to Git!
# ====================================================================

# --------------------------------------------------------------------
# 1. Application & Server Configuration
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=HireSync
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------------------------------
# 2. Authentication & JWT Security Configuration
# --------------------------------------------------------------------
# Generate a strong 256-bit secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
SALT_ROUNDS=10

# Auth Policy
PASSWORD_MIN_LENGTH=8
RESET_TOKEN_EXPIRY_MINUTES=60

# --------------------------------------------------------------------
# 3. Email / SMTP Configuration (for Forgot Password flow)
# --------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
MAIL_FROM="HireSync <noreply@hiresync.app>"
APP_BASE_URL=http://localhost:3000

# --------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# --------------------------------------------------------------------
DATABASE_URL=postgres://hiresync_user:hiresync_password@localhost:5432/hiresync_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiresync_db
DB_USER=hiresync_user
DB_PASSWORD=hiresync_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# --------------------------------------------------------------------
# 4. Redis & Background SLA Job Queue Configuration (BullMQ)
# --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------
# 5. ATS Resume Parser Engine Configuration
# --------------------------------------------------------------------
# Percentage thresholds for Tier 1 (Ideal Match) and Tier 2 (Conditional Match)
ATS_TIER1_THRESHOLD=80
ATS_TIER2_THRESHOLD=60

# Evaluation Weightages (Must sum to 1.0 / 100%)
ATS_WEIGHT_SKILLS=0.50
ATS_WEIGHT_EXPERIENCE=0.30
ATS_WEIGHT_EDUCATION=0.20

# --------------------------------------------------------------------
# 6. Candidate Upstream Eligibility & Gatekeeper Parameters
# --------------------------------------------------------------------
# Experience buffer percentage allowed for Skill Unlock test (e.g. 0.15 = 15% buffer)
SKILL_UNLOCK_BUFFER_PERCENTAGE=0.15
SKILL_UNLOCK_TEST_DURATION_MINUTES=15

# --------------------------------------------------------------------
# 7. Recruiter Decision SLA Engine Configuration
# --------------------------------------------------------------------
# Default decision SLA period in days
DEFAULT_SLA_DAYS=7
# Warning alerts sent at T-minus hours
SLA_WARNING_FIRST_HOURS=48
SLA_WARNING_FINAL_HOURS=24

# --------------------------------------------------------------------
# 8. WebRTC Real-Time Video Interviewing Parameters
# --------------------------------------------------------------------
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# --------------------------------------------------------------------
# 9. Email Notification Service (Nodemailer / SendGrid)
# --------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM_ADDRESS=no-reply@hiresync.com
MAIL_FROM_NAME="HireSync Automated SLA Engine"
SENDGRID_API_KEY=

# --------------------------------------------------------------------
# 10. ATS Resume Upload & File Storage
# --------------------------------------------------------------------
# Maximum allowed resume file size in bytes (default: 5242880 = 5 MB)
RESUME_MAX_FILE_SIZE_BYTES=5242880
# Comma-separated list of allowed MIME types for uploaded resumes
RESUME_ALLOWED_MIME_TYPES=application/pdf
# Storage backend for uploaded resumes: 'local' (dev) or 's3' (prod)
STORAGE_BACKEND=local
# Local filesystem path for resume storage (relative to project root)
LOCAL_UPLOAD_PATH=uploads/resumes
# AWS S3 bucket name (required when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
# AWS S3 region (e.g. ap-south-1 for Mumbai, us-east-1 for Virginia)
S3_REGION=ap-south-1

# --------------------------------------------------------------------
# 11. ATS Anti-Gaming & Resume Manipulation Safeguards
# --------------------------------------------------------------------
# Minimum visible font size in points — text below this is flagged as hidden (default: 4pt)
ATS_MIN_FONT_SIZE_PT=4
# Maximum number of skills allowed in a resume before anomaly flag (default: 35)
ATS_MAX_SKILL_COUNT=35
# Keyword-to-total-word ratio threshold above which density is flagged as suspicious
ATS_KEYWORD_DENSITY_THRESHOLD=0.25

