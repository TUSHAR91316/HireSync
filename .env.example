# ====================================================================
# HireSync Environment Variables Template
# Copy this file to '.env' for local development and update values.
# NEVER commit real credentials, API keys, or production secrets to Git!
# ====================================================================

# --------------------------------------------------------------------
# 1. Application & Server Configuration
# --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=HireSync
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------------------------------
# 2. Authentication & JWT Security Configuration
# --------------------------------------------------------------------
# Generate a strong 256-bit secret key for JWT signing
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
SALT_ROUNDS=10

# --------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# --------------------------------------------------------------------
DATABASE_URL=postgres://hiresync_user:hiresync_password@localhost:5432/hiresync_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiresync_db
DB_USER=hiresync_user
DB_PASSWORD=hiresync_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# --------------------------------------------------------------------
# 4. Redis & Background SLA Job Queue Configuration (BullMQ)
# --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------
# 5. ATS Resume Parser Engine Configuration
# --------------------------------------------------------------------
# Percentage thresholds for Tier 1 (Ideal Match) and Tier 2 (Conditional Match)
ATS_TIER1_THRESHOLD=80
ATS_TIER2_THRESHOLD=60

# Evaluation Weightages (Must sum to 1.0 / 100%)
ATS_WEIGHT_SKILLS=0.50
ATS_WEIGHT_EXPERIENCE=0.30
ATS_WEIGHT_EDUCATION=0.20

# --------------------------------------------------------------------
# 6. Candidate Upstream Eligibility & Gatekeeper Parameters
# --------------------------------------------------------------------
# Experience buffer percentage allowed for Skill Unlock test (e.g. 0.15 = 15% buffer)
SKILL_UNLOCK_BUFFER_PERCENTAGE=0.15
SKILL_UNLOCK_TEST_DURATION_MINUTES=15

# --------------------------------------------------------------------
# 7. Recruiter Decision SLA Engine Configuration
# --------------------------------------------------------------------
# Default decision SLA period in days
DEFAULT_SLA_DAYS=7
# Warning alerts sent at T-minus hours
SLA_WARNING_FIRST_HOURS=48
SLA_WARNING_FINAL_HOURS=24

# --------------------------------------------------------------------
# 8. WebRTC Real-Time Video Interviewing Parameters
# --------------------------------------------------------------------
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# --------------------------------------------------------------------
# 9. Email Notification Service (Nodemailer / SendGrid)
# --------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM_ADDRESS=no-reply@hiresync.com
MAIL_FROM_NAME="HireSync Automated SLA Engine"
SENDGRID_API_KEY=
